# Which backend the CMS talks to: mock (default, in-memory demo) | contentlibre | sling
UCP_BACKEND=mock

# --- UCP_BACKEND=contentlibre -------------------------------------------------
# Where the BFF reaches ContentLIBRE (server-to-server). The Management API is <origin>/api/management.
CONTENTLIBRE_URL=http://localhost:6727
# Where a BROWSER reaches ContentLIBRE's own tools (Repository Manager, Swagger). Defaults to CONTENTLIBRE_URL.
# CONTENTLIBRE_PUBLIC_URL=https://manage.example.com
# Development fallback ONLY: with no signed-in session the BFF calls the backend as this account (HTTP Basic),
# which makes every visitor the same person. Leave unset anywhere people share an instance; sign in instead.
# CONTENTLIBRE_USER=
# CONTENTLIBRE_PASSWORD=

# --- UCP_BACKEND=sling --------------------------------------------------------
# SLING_URL=http://localhost:8080
# SLING_USER=
# SLING_PASSWORD=
